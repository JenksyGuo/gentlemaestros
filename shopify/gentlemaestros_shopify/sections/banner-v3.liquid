

<div {% render 'section-attr', style: '--pt-mobile: 15rem;--pb-mobile: 15rem' %}>
  {% render 'section-bg-image' %}
  <xo-container {% render 'section-layout' %}>
    {% case section.settings.content_align %}
      {% when 'start' %}
        {% assign align = 'start' %}
      {% when 'center' %}
        {% assign align = 'center' %}
      {% else %}
        {% assign align = 'end' %}
    {% endcase %}
    {% case section.settings.text_align %}
      {% when 'start' %}
        {% assign text = 'start' %}
      {% when 'center' %}
        {% assign text = 'center' %}
      {% else %}
        {% assign align = 'end' %}
    {% endcase %}
    <div class='banner-v73__position' style='--align: {{ align }};'>
      <div class='banner-v73__content' style='--text: {{ text }};'>
        <xo-animate xo-cascade class='banner-v73__subtitle'>
          {{ section.settings.subtitle }}
        </xo-animate>
        <xo-animate xo-cascade>
          <h2 class='banner-v73__title'>{{ section.settings.title }}</h2>
        </xo-animate>
        <xo-animate xo-cascade class='banner-v73__description'>
          {{ section.settings.description }}
        </xo-animate>
        <xo-animate xo-cascade class='banner-v73__button'>
          {% render 'button',
            text: section.settings.button_text,
            link: section.settings.button_link,
            mode: section.settings.button_mode,
            style: section.settings.button_style,
            size: section.settings.button_size,
            radius: section.settings.button_radius,
            padding: section.settings.button_padding
          %}
        </xo-animate>
      </div>
    </div>
  </xo-container>
</div>

